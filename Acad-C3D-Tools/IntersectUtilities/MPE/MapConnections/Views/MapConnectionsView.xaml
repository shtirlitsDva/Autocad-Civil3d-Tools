<UserControl x:Class="IntersectUtilities.MPE.MapConnections.Views.MapConnectionsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}"
             d:DesignWidth="600" d:DesignHeight="500">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="GraphMode" Content="Graf" GroupName="Mode" IsChecked="True"
                         Style="{StaticResource ToggleRadioButtonStyle}" Checked="OnModeChanged" />
            <RadioButton x:Name="NetMode" Content="Net" GroupName="Mode" Margin="4,0,0,0"
                         Style="{StaticResource ToggleRadioButtonStyle}" Checked="OnModeChanged" />
            <Button Content="Opdater" Margin="16,0,0,0" Padding="12,4" Click="OnRefresh" />
            <Button Content="Tilpas" Margin="4,0,0,0" Padding="12,4" Click="OnFit" />
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Foreground="{StaticResource ForegroundMutedBrush}" TextTrimming="CharacterEllipsis" />
        <Border x:Name="Host" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="Surface" Background="Transparent" />
        </Border>
    </DockPanel>
</UserControl>
