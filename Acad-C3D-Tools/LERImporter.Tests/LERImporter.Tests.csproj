<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The host-free part of LERImporter's property-set writer: the shared AEC filer-stream
       codec (AecPropertySetsSHARED), the LER property-set schema and the unions they use.
       Linked, so the tests build without AutoCAD or BricsCAD. -->
  <ItemGroup>
    <Compile Include="..\AecPropertySetsSHARED\Unions.cs" Link="Sut\Unions.cs" />
    <Compile Include="..\AecPropertySetsSHARED\AecValues.cs" Link="Sut\AecValues.cs" />
    <Compile Include="..\AecPropertySetsSHARED\AecStream.cs" Link="Sut\AecStream.cs" />
    <Compile Include="..\LERImporter\PropertySets\LerPropertySetSchema.cs" Link="Sut\LerPropertySetSchema.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Norsyn.AecPropertySets" />
  </ItemGroup>

</Project>
