<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>97064ee0-2883-4766-800d-491f01e6d604</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>IntersectUtilitiesCOMMON</Import_RootNamespace>
  </PropertyGroup>
  <!--
    The IntersectUtilities code that needs no Civil 3D, AEC, Map or MPolygon, so
    it compiles for vanilla AutoCAD and for BricsCAD (BRICSCAD defined). Every
    project that imports UtilitiesCommonSHARED or PipelineSHARED imports this.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)BlockInserter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Collections\EntityCollection.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ComponentPorts.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ComponentSchedule.cs" />
