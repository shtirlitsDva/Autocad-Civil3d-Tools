    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\Distances.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\Dybde.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\EnhKoder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\FjvDynamicComponents.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\InstOgBr.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\Krydsninger.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\LagLer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\NsLoadRegister.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\PipeRadiusCsv.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\PipeScheduleCsv.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DataManager\CsvData\Stier.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Dimensioning\PipeLayerColours.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DynamicBlockPropertyReader.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Enums.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphWrite\GraphPopulation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GraphWrite\MyGraph.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Graphs\ConClass.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Graphs\Graph.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Graphs\GraphCollection.cs" />
