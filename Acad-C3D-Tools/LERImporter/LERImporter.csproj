<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<Nullable>enable</Nullable>
		<Platforms>x64</Platforms>
	</PropertyGroup>
	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
			None
		</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
	</PropertyGroup>
	<PropertyGroup>
		<OutputType>Library</OutputType>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Platform)' == 'x64' ">
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<!-- One project, two hosts: NorsynHost=AutoCAD (default) or BricsCAD, set in
	     Directory.Build.props. API names differ only in the using blocks at the top
	     of a file (#if BRICSCAD); where the hosts BEHAVE differently (property sets:
	     the AEC API on Civil, our own AEC stream writer on BricsCAD), the file has one
	     copy per host under Host\Acad and Host\Brx, and only the host's own folder
	     is compiled. The assembly is LERImporter on both. -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<!-- Each host has its own obj folder, so the other host's generated sources
		     must never be globbed into this build. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)' == 'AutoCAD'">
		<HostFolder>Acad</HostFolder>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<HostFolder>Brx</HostFolder>
		<DefineConstants>$(DefineConstants);BRICSCAD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Configuration)|$(Platform)' == 'AutoCAD|Debug|x64'">
		<OutputPath>bin\Debug\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Configuration)|$(Platform)' == 'AutoCAD|Release|x64'">
		<OutputPath>bin\Release\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Platform)' == 'BricsCAD|x64'">
		<OutputPath>bin\BricsCAD\$(Configuration)\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<ItemGroup Condition="'$(NorsynHost)' == 'AutoCAD'">
		<Reference Include="accoremgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\accoremgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="acdbmgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="acmgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acmgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcMPolygonMGD">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcMPolygonMGD.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AecArchMgd">
		  <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecArchMgd.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="AecBaseMgd">
		  <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecBaseMgd.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="AeccDataShortcutMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\C3D\AeccDataShortcutMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AeccDbMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\C3D\AeccDbMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AecPropDataMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecPropDataMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="ManagedMapApi">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\Map\ManagedMapApi.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<Reference Include="BrxMgd">
			<HintPath>$(BricsCADPath)\BrxMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="TD_Mgd">
			<HintPath>$(BricsCADPath)\TD_Mgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<!-- Only this host's alternates. -->
		<Compile Remove="Host\**" />
		<Compile Include="Host\$(HostFolder)\**\*.cs" />
	</ItemGroup>
	<ItemGroup>
		<!-- Share the mapping with LERHATCHLAYERS without an IntersectUtilities DLL dependency. -->
		<Compile Include="..\IntersectUtilities\LerHatchLayers\LerHatchLayers.cs">
			<Link>LerHatchLayers\LerHatchLayers.cs</Link>
		</Compile>
		<Compile Include="..\IntersectUtilities\MoreLinq\DistinctBy.cs">
			<Link>DistinctBy.cs</Link>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<None Update="Schema\1.0_annotations.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="Schema\1.0_dimensions.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="Schema\1.0_ler.xsd">
			<SubType>Designer</SubType>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Content Include="DebugCommandLineAttribute.txt" />
	</ItemGroup>
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<AssemblyName>LERImporter</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
		<PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.3.0" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
		<PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
	</ItemGroup>
	<Import Project="..\IntersectUtilitiesCOMMON\IntersectUtilitiesCOMMON.projitems" Label="Shared" />
	<!-- UtilitiesCommonSHARED needs Civil 3D, AEC and Map: AutoCAD lane only. The
	     BricsCAD lane takes just its CSV data sources, which need none of them. -->
	<Import Project="..\UtilitiesCommonSHARED\UtilitiesCommonSHARED.projitems" Label="Shared"
	        Condition="'$(NorsynHost)' == 'AutoCAD'" />
	<ItemGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<Compile Include="..\UtilitiesCommonSHARED\DataManager\CsvData\*.cs">
			<Link>UtilitiesCommonSHARED\CsvData\%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>
	<Import Project="..\FormsSHARED\FormsSHARED.projitems" Label="Shared" />
	<!-- AEC property sets without the AEC API (the codec on every lane, its BricsCAD
	     object layer on the BricsCAD lane only), shared with NorsynDrawingTools. -->
	<Import Project="..\AecPropertySetsSHARED\AecPropertySetsSHARED.projitems" Label="Shared" />

	<Target Name="RequireKnownHost" BeforeTargets="CollectPackageReferences;ResolveAssemblyReferences">
		<Error Condition="'$(NorsynHost)' != 'AutoCAD' And '$(NorsynHost)' != 'BricsCAD'"
		       Text="NorsynHost must be AutoCAD or BricsCAD, not '$(NorsynHost)'." />
		<Error Condition="'$(NorsynHost)' == 'BricsCAD' And !Exists('$(BricsCADPath)\BrxMgd.dll')"
		       Text="BrxMgd.dll not found in '$(BricsCADPath)'. Pass -p:BricsCADPath=&lt;BricsCAD V26 install folder&gt;." />
	</Target>
</Project>
