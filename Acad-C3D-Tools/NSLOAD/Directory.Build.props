<Project>
	<!-- NSLOAD is built for one host at a time. The host is an MSBuild property,
	     not a second project, so both builds compile the same sources:
	       msbuild NSLOAD.csproj                          (AutoCAD / Civil 3D 2025)
	       msbuild NSLOAD.csproj -p:NorsynHost=BricsCAD   (BricsCAD V26)
	     This file runs before the SDK props, which is the only place the
	     intermediate folder can still be chosen: each host restores and compiles
	     into its own obj folder, so neither lane's incremental state or
	     project.assets.json is ever overwritten by the other. -->
	<PropertyGroup>
		<NorsynHost Condition="'$(NorsynHost)' == ''">AutoCAD</NorsynHost>

		<!-- The BricsCAD install the BricsCAD lane compiles against. Override on the
		     command line (-p:BricsCADPath=...) or with an environment variable. A
		     machine without BricsCAD falls back to the reference copies in the BRX SDK. -->
		<BricsCADPath Condition="'$(BricsCADPath)' == ''">C:\Program Files\Bricsys\BricsCAD V26 en_US</BricsCADPath>
		<BricsCADPath Condition="!Exists('$(BricsCADPath)\BrxMgd.dll') And Exists('C:\BRXSDK\BRX26.2.03.0\extra\dotnet\ref\BrxMgd.dll')">C:\BRXSDK\BRX26.2.03.0\extra\dotnet\ref</BricsCADPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<BaseIntermediateOutputPath>obj\BricsCAD\</BaseIntermediateOutputPath>
	</PropertyGroup>
</Project>
