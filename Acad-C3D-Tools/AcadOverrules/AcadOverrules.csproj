<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<Nullable>enable</Nullable>
		<Platforms>x64</Platforms>
	</PropertyGroup>
	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<AssemblyName>AcadOverrules</AssemblyName>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Platform)' == 'x64' ">
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<!-- One project, two hosts: NorsynHost=AutoCAD (default) or BricsCAD, set in
	     Directory.Build.props. API names differ only in the using blocks at the top
	     of a file (#if BRICSCAD); where the hosts differ in more than a name (the
	     GraphicsInterface TextStyle constructor), the file has one copy per host
	     under Host\Acad and Host\Brx, and only the host's own folder is compiled.
	     The assembly is AcadOverrules on both. -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<!-- Each host has its own obj folder, so the other host's generated sources
		     must never be globbed into this build. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)' == 'AutoCAD'">
		<HostFolder>Acad</HostFolder>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<HostFolder>Brx</HostFolder>
		<DefineConstants>$(DefineConstants);BRICSCAD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Configuration)|$(Platform)' == 'AutoCAD|Debug|x64'">
		<OutputPath>bin\Debug\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Configuration)|$(Platform)' == 'AutoCAD|Release|x64'">
		<OutputPath>bin\Release\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NorsynHost)|$(Platform)' == 'BricsCAD|x64'">
		<OutputPath>bin\BricsCAD\$(Configuration)\</OutputPath>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<ItemGroup Condition="'$(NorsynHost)' == 'BricsCAD'">
		<Reference Include="BrxMgd">
			<HintPath>$(BricsCADPath)\BrxMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="TD_Mgd">
			<HintPath>$(BricsCADPath)\TD_Mgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<!-- Only this host's alternates. -->
		<Compile Remove="Host\**" />
		<Compile Include="Host\$(HostFolder)\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(NorsynHost)' == 'AutoCAD'">
		<Reference Include="accoremgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\accoremgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcCui">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcCui.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="acdbmgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="acdbmgdbrep">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acdbmgdbrep.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcDx">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcDx.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="acmgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\acmgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcMPolygonMGD">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcMPolygonMGD.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcMr">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcMr.DLL</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcSeamless">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcSeamless.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcTcMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcTcMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AcWindows">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AcWindows.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AdUiPalettes">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AdUiPalettes.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AdWindows">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\AdWindows.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AecArchMgd">
		  <HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecArchMgd.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="AecBaseMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecBaseMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AeccDataShortcutMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\C3D\AeccDataShortcutMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AeccDbMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\C3D\AeccDbMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="AecPropDataMgd">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\ACA\AecPropDataMgd.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="ManagedMapApi">
			<HintPath>C:\Program Files\Autodesk\AutoCAD 2025\Map\ManagedMapApi.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<!-- The shared dark theme and its title bar helper live in the DimensioneringV2 repo,
	     linked in the same way IntersectUtilities does it. All WPF styling belongs there. -->
	<ItemGroup Condition="Exists('..\..\..\..\DamgaardRI\DimensioneringV2\src\DimensioneringV2.UI\UI\Theme.xaml')">
		<Page Include="..\..\..\..\DamgaardRI\DimensioneringV2\src\DimensioneringV2.UI\UI\Theme.xaml" Link="CmdUI\UI\Theme.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>
	<ItemGroup Condition="Exists('..\..\..\..\DamgaardRI\DimensioneringV2\src\DimensioneringV2.UI\UI\DarkTitleBarHelper.cs')">
		<Compile Include="..\..\..\..\DamgaardRI\DimensioneringV2\src\DimensioneringV2.UI\UI\DarkTitleBarHelper.cs" Link="CmdUI\UI\DarkTitleBarHelper.cs" />
		<!-- The linked helper is written for a project with ImplicitUsings on. Turning those on
		     wholesale here would make System.Drawing/System.Windows.Forms ambiguous with WPF in
		     the existing overrules, so only the one namespace it needs is made global. -->
		<Using Include="System" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
		<PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
		<PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Docs\" />
	</ItemGroup>
	<!-- Both hosts compile the same shared code: IntersectUtilitiesCOMMON is host-free.
	     UtilitiesCommonSHARED (Civil 3D, AEC, Map) is not imported on either lane. -->
	<Import Project="..\IntersectUtilitiesCOMMON\IntersectUtilitiesCOMMON.projitems" Label="Shared" />
	<Import Project="..\FormsSHARED\FormsSHARED.projitems" Label="Shared" />

	<Target Name="RequireKnownHost" BeforeTargets="CollectPackageReferences;ResolveAssemblyReferences">
		<Error Condition="'$(NorsynHost)' != 'AutoCAD' And '$(NorsynHost)' != 'BricsCAD'"
		       Text="NorsynHost must be AutoCAD or BricsCAD, not '$(NorsynHost)'." />
		<Error Condition="'$(NorsynHost)' == 'BricsCAD' And !Exists('$(BricsCADPath)\BrxMgd.dll')"
		       Text="BrxMgd.dll not found in '$(BricsCADPath)'. Pass -p:BricsCADPath=&lt;BricsCAD V27 install folder&gt;." />
	</Target>
</Project>
