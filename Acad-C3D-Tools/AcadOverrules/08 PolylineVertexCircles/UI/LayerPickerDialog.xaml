<Window x:Class="AcadOverrules.VertexCircles.UI.LayerPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Add layers from drawing"
        Width="420" Height="520"
        MinWidth="320" MinHeight="320"
        ShowInTaskbar="False"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/AcadOverrules;component/CmdUI/UI/Theme.xaml"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tick the layers the overrule should apply to."
                   Style="{StaticResource DialogLabelStyle}"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="1"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FormTextBoxStyle}"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,8"
                 ToolTip="Type to narrow the list down"/>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding VisibleLayers}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsSelected}"
                              Style="{StaticResource FormCheckBoxStyle}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Select all shown"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SelectAllVisibleCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="Clear"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearSelectionCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add"
                        Style="{StaticResource DialogButtonStyle}"
                        IsDefault="True"
                        Click="OnAddClick"/>
                <Button Content="Cancel"
                        Style="{StaticResource DialogButtonStyle}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
