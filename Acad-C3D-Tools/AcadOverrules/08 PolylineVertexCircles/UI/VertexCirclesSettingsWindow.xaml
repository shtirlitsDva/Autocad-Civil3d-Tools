<Window x:Class="AcadOverrules.VertexCircles.UI.VertexCirclesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Polyline vertex circles"
        Width="580" Height="840"
        MinWidth="500" MinHeight="720"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AcadOverrules;component/CmdUI/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One marker style. Bound to a MarkerStyleViewModel, so the Straight vertices tab
                 and the Arc vertices tab are this same template over different instances. -->
            <DataTemplate x:Key="MarkerStyleTemplate">
                <StackPanel Margin="4">
                    <Grid Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Content="Radius"
                               Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="90"
                                 ToolTip="Circle radius in drawing units. Fixed - it does not follow the polyline width."/>
                    </Grid>

                    <Grid Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Content="Lineweight factor"
                               Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding LineWeightFactorText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="90"
                                 ToolTip="How much thicker the circle is drawn than the polyline. Needs LWDISPLAY on to be visible."/>
                    </Grid>

                    <Grid Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Content="Linetype"
                               Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.AvailableLinetypes,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Linetype}"
                                  Style="{StaticResource ModernDarkComboBox}"
                                  HorizontalAlignment="Left"
                                  Width="200"
                                  ToolTip="Linetype the circle is drawn with. Lists the linetypes loaded in the active drawing. A profile whose linetype is not loaded in the drawing on screen draws Continuous. Whether a dashed pattern shows at all depends on LTSCALE."/>
                    </Grid>

                    <Grid Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Content="Colour"
                               Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Use a fixed colour"
                                      IsChecked="{Binding UseFixedColor}"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      ToolTip="Off: the complementary hue of each polyline's own colour, always fully saturated."/>
                            <Border Width="22" Height="18"
                                    Background="{Binding FixedColorBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    IsEnabled="{Binding UseFixedColor}"/>
                            <Button Content="Pick..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PickFixedColorCommand}"
                                    IsEnabled="{Binding UseFixedColor}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- One segment style. Bound to a SegmentStyleViewModel, so the Straight segments
                 tab and the Arc segments tab are this same template over different instances.
                 Every setting has a "same as the polyline" value, so a freshly enabled
                 override changes nothing until something is picked. -->
            <DataTemplate x:Key="SegmentStyleTemplate">
                <StackPanel Margin="4">
                    <CheckBox Content="Override how these segments are drawn"
                              IsChecked="{Binding IsOverridden}"
                              Style="{StaticResource FormCheckBoxStyle}"
                              Margin="0,0,0,8"
                              ToolTip="Off: the polyline draws these segments itself. On: the overrule draws them with the settings below in place of the polyline's own graphics."/>

                    <StackPanel IsEnabled="{Binding IsOverridden}">
                        <Grid Style="{StaticResource FormRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Content="Colour"
                                   Style="{StaticResource FormLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ColorModes}"
                                          SelectedValuePath="Mode"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding ColorMode}"
                                          Style="{StaticResource ModernDarkComboBox}"
                                          Width="170"
                                          Margin="0,0,10,0"
                                          ToolTip="Same as the polyline: no change. Complementary hue: the fully saturated complement of each polyline's own colour, the same rule the circles use. Fixed colour: the colour picked here."/>
                                <Border Width="22" Height="18"
                                        Background="{Binding FixedColorBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        IsEnabled="{Binding IsFixedColor}"/>
                                <Button Content="Pick..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PickFixedColorCommand}"
                                        IsEnabled="{Binding IsFixedColor}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource FormRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Content="Lineweight factor"
                                   Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding LineWeightFactorText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Width="90"
                                     ToolTip="How much thicker the segment is drawn than the polyline. 1 keeps the polyline's lineweight as it is. Needs LWDISPLAY on to be visible."/>
                        </Grid>

                        <Grid Style="{StaticResource FormRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Content="Linetype"
                                   Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DataContext.AvailableSegmentLinetypes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Linetype}"
                                      Style="{StaticResource ModernDarkComboBox}"
                                      HorizontalAlignment="Left"
                                      Width="200"
                                      ToolTip="Linetype the segment is drawn with. Same as the polyline keeps the polyline's own. Otherwise lists the linetypes loaded in the active drawing; a name not loaded in the drawing on screen draws Continuous."/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profiles -->
        <GroupBox Grid.Row="0"
                  Header="Profile"
                  Style="{StaticResource ModernGroupBox}"
                  Margin="0,0,0,10">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ModernDarkComboBox}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="New"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NewProfileCommand}"
                            Margin="0,0,4,0"/>
                    <Button Content="Copy"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CopyProfileCommand}"
                            Margin="0,0,4,0"/>
                    <Button Content="Rename"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RenameProfileCommand}"
                            Margin="0,0,4,0"/>
                    <Button Content="Delete"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteProfileCommand}"
                            IsEnabled="{Binding CanDeleteProfile}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Appearance -->
        <GroupBox Grid.Row="1"
                  Header="Appearance"
                  Style="{StaticResource ModernGroupBox}"
                  Margin="0,0,0,10"
                  DataContext="{Binding SelectedProfile}">
            <StackPanel Margin="4">
                <TextBlock Text="Vertices get a circle: straight, or arc when the vertex starts or ends an arc segment as chosen below. Segments can replace the polyline's own graphics with their own colour, lineweight and linetype."
                           Style="{StaticResource DialogLabelStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TabControl>
                    <TabItem Header="Straight vertices">
                        <ContentControl Content="{Binding Straight}"
                                        ContentTemplate="{StaticResource MarkerStyleTemplate}"/>
                    </TabItem>
                    <TabItem Header="Arc vertices">
                        <StackPanel>
                            <Grid Style="{StaticResource FormRowStyle}" Margin="4,4,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Content="Counts as arc vertex"
                                       Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox Content="Start of an arc"
                                              IsChecked="{Binding ArcVertexAtArcStart}"
                                              Style="{StaticResource FormCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              ToolTip="The vertex where an arc segment begins - the arc is the segment leaving the vertex."/>
                                    <CheckBox Content="End of an arc"
                                              IsChecked="{Binding ArcVertexAtArcEnd}"
                                              Style="{StaticResource FormCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              ToolTip="The vertex where an arc segment ends - the arc is the segment arriving at the vertex. With both on, every vertex touching an arc is an arc vertex; turn one off to tell a straight segment between two arcs from a third arc."/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Neither is on, so no vertex is an arc vertex and every vertex uses the Straight vertices style."
                                       Style="{StaticResource DialogLabelStyle}"
                                       Foreground="{DynamicResource SeverityWarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="4,2,4,0"
                                       Visibility="{Binding MarksNoArcVertices,
                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <ContentControl Content="{Binding Arc}"
                                            ContentTemplate="{StaticResource MarkerStyleTemplate}"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Straight segments">
                        <ContentControl Content="{Binding StraightSegment}"
                                        ContentTemplate="{StaticResource SegmentStyleTemplate}"/>
                    </TabItem>
                    <TabItem Header="Arc segments">
                        <ContentControl Content="{Binding ArcSegment}"
                                        ContentTemplate="{StaticResource SegmentStyleTemplate}"/>
                    </TabItem>
                </TabControl>

                <TextBlock Text="Radius and lineweight factor must be positive numbers in every tab."
                           Style="{StaticResource DialogLabelStyle}"
                           Foreground="{DynamicResource SeverityWarningBrush}"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsInvalid,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </GroupBox>

        <!-- Layers -->
        <GroupBox Grid.Row="2"
                  Header="Layers"
                  Style="{StaticResource ModernGroupBox}"
                  DataContext="{Binding SelectedProfile}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Layer names or masks, AutoCAD wildcards allowed (0-FJV-*). An empty list means every layer. The filter applies to the circles and to the segment overrides alike."
                           Style="{StaticResource DialogLabelStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LayerFilters}"
                         MinHeight="90"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,6,0"/>

                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.RemoveFilterCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add mask"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddMaskCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="Add from drawing..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DataContext.AddLayersFromDrawingCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,0,6,0"/>
                    <Button Content="Clear"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3"
                   Text="{Binding SettingsPath}"
                   Style="{StaticResource DialogLabelStyle}"
                   Foreground="{DynamicResource TextMuted}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding SettingsPath}"
                   Margin="0,10,0,0"/>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <CheckBox Content="Overrule enabled"
                          IsChecked="{Binding IsOverruleEnabled}"
                          Style="{StaticResource FormCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="Same switch as TOGGLEPOLYVERTICES"/>
                <Button Content="Reset profile"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetProfileCommand}"/>
            </StackPanel>

            <Button Content="Close"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="90"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
