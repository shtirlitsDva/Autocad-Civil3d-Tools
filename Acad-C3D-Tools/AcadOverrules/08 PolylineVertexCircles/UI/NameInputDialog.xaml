<Window x:Class="AcadOverrules.VertexCircles.UI.NameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Profile"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource DialogWindowStyle}"
        Background="{DynamicResource Background}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/AcadOverrules;component/CmdUI/UI/Theme.xaml"/>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="CaptionText"
                   Style="{StaticResource DialogLabelStyle}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="NameBox"
                 Style="{StaticResource FormTextBoxStyle}"
                 HorizontalAlignment="Stretch"
                 KeyDown="OnNameBoxKeyDown"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="OK"
                    Style="{StaticResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="OnOkClick"/>
            <Button Content="Cancel"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
